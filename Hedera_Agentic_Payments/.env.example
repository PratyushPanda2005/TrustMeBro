# ---------- Hedera (x402) ----------
# Facilitator: Blocky402 primary, x402.org fallback (both listed in Hedera docs)
FACILITATOR_URL=https://api.testnet.blocky402.com
# FACILITATOR_URL=https://x402.org/facilitator
HEDERA_NETWORK=hedera:testnet
# Testnet USDC (HTS) 6 decimals. Do NOT use 0.0.6001 / 0.0.9001 from docs examples.
HEDERA_USDC_TOKEN_ID=0.0.429274

# Verifier (merchant) — plain 0.0.x account, ECDSA, USDC-associated
VERIFIER_PAYTO=0.0.xxxxxxx
# Hedera key for the payTo account (only used by `pnpm associate-usdc`)
VERIFIER_HEDERA_PRIVATE_KEY=0x...
VERIFIER_PORT=4021
# EVM key that signs EIP-712 Verification responses (approved verifier in TradeDeals)
VERIFIER_EVM_PRIVATE_KEY=0x...
VERIFIER_SCENARIO=honest
VERIFIER_ADMIN_TOKEN=change-me
VERIFY_TTL_SEC=600

# Agent (payer) — ECDSA, USDC-associated, funded via faucet.circle.com
AGENT_HEDERA_ACCOUNT_ID=0.0.xxxxxxx
AGENT_HEDERA_PRIVATE_KEY=0x...
VERIFIER_URL=http://localhost:4021
AGENT_API_PORT=4002
AGENT_API_TOKEN=change-me
# mock mode only: emit one demo shipment at start (0 to disable)
MOCK_DEMO_SHIPMENT=1
# Spending policy (USDC atomic units, 6 dp)
POLICY_MAX_PER_CALL=1000000
POLICY_MAX_PER_DEAL=1000000
POLICY_MAX_PER_DAY=10000000
# plan v5 §9: first check + up to 2 rechecks per deal; spam guard per exporter
POLICY_MAX_CHECKS_PER_DEAL=3
POLICY_MAX_CHECKS_PER_EXPORTER_PER_DAY=5

# HCS audit topic (created by `pnpm --filter @tmb/audit create-topic`)
AUDIT_OPERATOR_ID=0.0.xxxxxxx
AUDIT_OPERATOR_KEY=0x...
AUDIT_TOPIC_ID=0.0.xxxxxxx
# HCS writer: "agentkit" (Hedera Agent Kit consensus tools, default) or "sdk" (plain @hiero-ledger/sdk)
AUDIT_SINK=agentkit

# ---------- Whitechain (relay) ----------
WHITECHAIN_RPC=https://rpc.testnet.whitechain.io
WHITECHAIN_WS=wss://rpc.testnet.whitechain.io/ws
WHITECHAIN_CHAIN_ID=1874
TRADE_DEALS_ADDRESS=0x...
# Relayer EOA that submits verifications (needs WBT for gas)
RELAYER_PRIVATE_KEY=0x...
# Agent adapter: "mock" until contracts are deployed, then "whitechain"
CHAIN_ADAPTER=mock
# first block to scan for ShipmentDeclared on restart (deployment block)
WHITECHAIN_FROM_BLOCK=0
