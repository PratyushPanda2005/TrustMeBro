# Copy to this package's .env. Shell values override it; Hedera root .env is fallback.
# Read-only diagnostics and discovery need no credentials. Do not set V2_EXECUTE.
WHITECHAIN_RPC=https://rpc.testnet.whitechain.io
WHITECHAIN_FROM_BLOCK=
VERIFIER_ADDRESS=
V2_METADATA_FILE=
V2_STATE_DIR=.state/v2
V2_POLL_MS=15000
EVIDENCE_MODE=real
VERIFIER_URL=http://localhost:4021
# Required only for separately authorized live execution. Leave blank for inspection.
VERIFIER_PAYTO=
AGENT_HEDERA_ACCOUNT_ID=
AGENT_HEDERA_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
