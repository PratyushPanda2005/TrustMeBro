# Copy to contracts/.env (not committed). Foundry reads it automatically.
# Don't put private keys here. Store the deployer key once with:
#   cast wallet import deployer --interactive

WHITECHAIN_RPC=https://rpc.testnet.whitechain.io

# Deploy.s.sol
# Required: address of the verifier's EIP-712 signing key (from the verifier service).
VERIFIER_ADDRESS=
# Optional fee wallets. Empty = deployer address.
AGENT_WALLET=
GAS_RELAYER=
RESERVE_FUND=
PLATFORM_TREASURY=
# Only for local testing. On chain 1874 the official USDT is always used.
USDT_ADDRESS=

# Kyc.s.sol
TRADEDEALS_ADDRESS=
EXPORTER_ADDRESS=
IMPORTER_ADDRESS=
INVESTOR_ADDRESS=
