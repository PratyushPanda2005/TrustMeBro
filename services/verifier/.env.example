# Copy to services/verifier/.env (not committed). Not needed for "npm run local", which sets its own values.

PORT=4021
RPC_URL=https://rpc.testnet.whitechain.io
# Empty = taken from packages/shared deployments after contracts/script/export.mjs
TRADEDEALS_ADDRESS=

# The verifier's EVM signing key. Its address must be VERIFIER_ADDRESS from the deploy, or the server refuses to start.
# Make one with: cast wallet new
VERIFIER_SIGNER_PK=

# How long a signed answer stays valid (seconds)
SIGNATURE_TTL_SECONDS=600

# x402 on Hedera. PAYMENTS=off makes /verify free (local development only).
PAYMENTS=on
PRICE=$0.30
HEDERA_NETWORK=hedera:testnet
HEDERA_USDC=0.0.429274
# The verifier's Hedera account that receives the USDC (must be associated with 0.0.429274)
VERIFIER_PAYTO=
FACILITATOR_URL=https://api.testnet.blocky402.com

# Demo controls (PUT /demo/scenarios/...). Set a token so only you can switch scenarios during the demo.
DEFAULT_SCENARIO=honest
DEMO_TOKEN=
# The dashboard's URL in production, e.g. https://trustmebro.vercel.app
CORS_ORIGIN=*
