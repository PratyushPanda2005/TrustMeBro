# Copy to this package's .env; fill existing credentials privately. Empty means missing.
# Never use the Admin private key. No key is generated by startup/diagnostics.
SERVICE_SIGNER_PRIVATE_KEY=
VERIFIER_ADDRESS=
VERIFIER_PAYTO=
RPC_URL=https://rpc.testnet.whitechain.io
PORT=4021
PAYMENTS=on
HEDERA_NETWORK=hedera:testnet
HEDERA_USDC=0.0.429274
FACILITATOR_URL=https://api.testnet.blocky402.com
PRICE=$0.30
EVIDENCE_MODE=real
# Optional trusted module; blank means Insufficient Evidence, not approval.
SHIPPING_PROVIDER_MODULE=
V2_REPORT_DIR=.state/v2-reports
